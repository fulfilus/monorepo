# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fulfilus"
ANTHROPIC_API_KEY="sk-ant-..."

# ── Optional: Google Maps enrichment ──────────────────────────────────────────
# Server-side key with Places API enabled. No HTTP referrer restrictions.
GOOGLE_MAPS_SERVER_KEY=""

# ── Optional: CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Defaults to localhost:4200.
ALLOWED_ORIGINS="http://localhost:4200"

# ── Optional: WhatsApp Cloud API onboarding webhook ───────────────────────────
# From Meta Developer Console → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_TOKEN=""
# Must match the Verify Token set in the Meta webhook config
WHATSAPP_VERIFY_TOKEN="fulfilus-verify"
