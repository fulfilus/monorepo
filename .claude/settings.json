{
  "theme": "dark",
  "autoCompact": true,
  "compactThreshold": 80,
  "hooks": {
    "PreCompact": [{ "matcher": "", "hooks": [{ "type": "command", "command": "bash -c 'exec \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/precompact.sh\" \"$@\"' --" }] }],
    "SessionStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "bash -c 'exec \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/session-start.sh\" \"$@\"' --" }] }],
    "PostToolUse": [{ "matcher": "", "hooks": [{ "type": "command", "command": "bash -c 'exec \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.claude/hooks/post-tool-use.sh\" \"$@\"' --" }] }]
  },
  "commands": {
    "directory": ".claude/commands"
  },
  "skills": {
    "directory": ".claude/skills"
  },
  "agents": {
    "directory": ".claude/agents"
  },
  "outputStyles": {
    "directory": ".claude/output-styles",
    "default": "concise"
  },
  "rules": {
    "directory": ".claude/rules"
  },
  "statusline": {
    "enabled": true,
    "config": ".claude/statusline/statusline.json"
  },
  "safety": {
    "confirmDestructive": true,
    "confirmProduction": true
  }
}
